{
  "comments": {
    "lineComment": "!"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "(%|\\*)?[A-Za-z_][A-Za-z0-9_.]*[$%]?|\\d+(\\.\\d+)?",
  "folding": {
    "markers": {
      "start": "^\\s*(\\d+\\s+)?!\\s*#region\\b",
      "end": "^\\s*(\\d+\\s+)?!\\s*#endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "(?i)^\\s*(\\d+\\s+)?(FOR\\b(?!.*\\bNEXT\\b)|WHILE\\b|REPEAT\\b|SWITCH\\b|CASE\\b|DEFAULT\\b|DEF\\s+CLASS\\b|TRY\\b|CATCH\\b|FINALLY\\b|SELECT\\b(?!.*\\bNEXT\\s+RECORD\\b))|\\{\\s*(!.*)?$",
    "decreaseIndentPattern": "(?i)^\\s*(\\d+\\s+)?(NEXT\\b|WEND\\b|UNTIL\\b|END\\s*SWITCH\\b|CASE\\b|DEFAULT\\b|END\\s*DEF\\b|ENDDEF\\b|END_TRY\\b|CATCH\\b|FINALLY\\b|\\})"
  },
  "onEnterRules": []
}
