{
  "FOR loop": { "prefix": "for", "body": ["FOR ${1:I}=${2:1} TO ${3:10}", "\t$0", "NEXT ${1:I}"], "description": "FOR ... NEXT loop" },
  "WHILE loop": { "prefix": "while", "body": ["WHILE ${1:condition}", "\t$0", "WEND"], "description": "WHILE ... WEND loop" },
  "REPEAT loop": { "prefix": "repeat", "body": ["REPEAT", "\t$0", "UNTIL ${1:condition}"], "description": "REPEAT ... UNTIL loop" },
  "IF block": { "prefix": "ifb", "body": ["IF ${1:condition} THEN {", "\t$0", "}"], "description": "IF ... THEN { } block" },
  "IF/ELSE block": { "prefix": "ifelse", "body": ["IF ${1:condition} THEN {", "\t$2", "} ELSE {", "\t$0", "}"], "description": "IF ... THEN { } ELSE { } block" },
  "SWITCH": { "prefix": "switch", "body": ["SWITCH ${1:expression}", "CASE ${2:value}", "\t$0", "\tBREAK", "DEFAULT", "\tBREAK", "END SWITCH"], "description": "SWITCH ... END SWITCH" },
  "SELECT loop": { "prefix": "select", "body": ["SELECT ${1:*},REC=${2:rec\\$} FROM ${3:chan} BEGIN ${4:key\\$} END ${4:key\\$}+\\$FE\\$ WHERE ${5:condition}", "\t$0", "NEXT RECORD"], "description": "SELECT ... NEXT RECORD loop over a file" },
  "TRY/CATCH": { "prefix": "try", "body": ["TRY", "\t$1", "CATCH", "\t$0", "END_TRY"], "description": "TRY ... CATCH ... END_TRY" },
  "Class definition": {
    "prefix": "defclass",
    "body": [
      "DEF CLASS \"${1:ClassName}\" CREATE REQUIRED DELETE REQUIRED",
      "\t! Inherits from",
      "\tLIKE \"${2:SY_Service}\"",
      "\t! Public properties",
      "\tPROPERTY ${3:Name\\$}",
      "\t! Local properties",
      "\tLOCAL ${4:cValue}",
      "\t! Public methods",
      "\tFUNCTION ${5:DoWork}(${6:arg\\$})${7:DO_WORK}",
      "END DEF",
      "",
      "ON_CREATE:",
      "ENTER coSession",
      "RETURN",
      "",
      "ON_DELETE:",
      "RETURN",
      "",
      "${7:DO_WORK}:",
      "ENTER ${6:arg\\$}",
      "$0",
      "RETURN retSUCCESS"
    ],
    "description": "DEF CLASS ... END DEF with constructor/destructor and one method"
  },
  "Method": { "prefix": "function", "body": ["FUNCTION ${1:Name}(${2:args})${3:LABEL}"], "description": "Class method declaration" },
  "Property with GET/SET": { "prefix": "property", "body": ["PROPERTY ${1:Name} GET ${2:GET_LABEL} SET ${3:SET_LABEL}"], "description": "Property with accessors" },
  "Subroutine": { "prefix": "sub", "body": ["${1:LABEL}:", "\t$0", "RETURN"], "description": "Labelled subroutine for GOSUB" },
  "Entry point": { "prefix": "entry", "body": ["${1:ENTRY}:", "ENTER ${2:args}", "$0", "EXIT"], "description": "Called program entry point (CALL \"prog;ENTRY\")" },
  "Open file": { "prefix": "open", "body": ["LET ${1:ch}=HFN; OPEN (${1:ch},IOL=*,ERR=${2:*NEXT})\"${3:filename}\""], "description": "Open a file on a free channel" },
  "Read by key": { "prefix": "readkey", "body": ["READ (${1:ch},KEY=${2:key\\$},DOM=${3:*NEXT})${4:IOL=*}"], "description": "READ a record by key" },
  "Error handler": { "prefix": "seterr", "body": ["SETERR ${1:ERROR_HANDLER}", "$0", "", "${1:ERROR_HANDLER}:", "PRINT \"Error \",ERR,\" at \",ERS", "RETRY"], "description": "SETERR error handler" },
  "Message box": { "prefix": "msgbox", "body": ["MSGBOX ${1:\"message\"},${2:\"title\"},\"${3:OK}\",${4:answer\\$}"], "description": "MSGBOX dialog" }
}
