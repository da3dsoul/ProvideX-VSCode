{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ProvideX",
  "scopeName": "source.providex",
  "fileTypes": [
    "pvx",
    "pvt",
    "pvxsrc",
    "bbx",
    "pxs"
  ],
  "patterns": [
    {
      "include": "#line-start"
    },
    {
      "include": "#statement"
    }
  ],
  "repository": {
    "line-start": {
      "patterns": [
        {
          "match": "^(\\s*)(\\d+)(\\??)(?=\\s|$)(?:(\\s+)([A-Za-z_][A-Za-z0-9_.]*)(:)(?!=))?",
          "captures": {
            "2": {
              "name": "constant.numeric.line-number.providex"
            },
            "3": {
              "name": "invalid.illegal.syntax-error.providex"
            },
            "5": {
              "name": "entity.name.label.providex"
            },
            "6": {
              "name": "punctuation.separator.label.providex"
            }
          }
        },
        {
          "match": "^(\\s*)([A-Za-z_][A-Za-z0-9_.]*)(:)(?!=)",
          "captures": {
            "2": {
              "name": "entity.name.label.providex"
            },
            "3": {
              "name": "punctuation.separator.label.providex"
            }
          }
        }
      ]
    },
    "statement": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#hex-string"
        },
        {
          "include": "#rem"
        },
        {
          "include": "#mnemonic"
        },
        {
          "include": "#member"
        },
        {
          "include": "#special"
        },
        {
          "include": "#option"
        },
        {
          "include": "#def-fn"
        },
        {
          "include": "#user-function"
        },
        {
          "include": "#function"
        },
        {
          "include": "#control"
        },
        {
          "include": "#oop"
        },
        {
          "include": "#operator-word"
        },
        {
          "include": "#directive"
        },
        {
          "include": "#sysvar"
        },
        {
          "include": "#branch-target"
        },
        {
          "include": "#number"
        },
        {
          "include": "#global-variable"
        },
        {
          "include": "#string-variable"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comment": {
      "match": "!.*$",
      "name": "comment.line.exclamation.providex"
    },
    "rem": {
      "match": "(?i)(?<![A-Za-z0-9_$%.'])(REM)(?![A-Za-z0-9_$%.])(.*)$",
      "captures": {
        "1": {
          "name": "keyword.other.rem.providex"
        },
        "2": {
          "name": "comment.line.rem.providex"
        }
      }
    },
    "string": {
      "begin": "\"",
      "end": "\"(?!\")|$",
      "name": "string.quoted.double.providex",
      "patterns": [
        {
          "match": "\"\"",
          "name": "constant.character.escape.providex"
        }
      ]
    },
    "hex-string": {
      "match": "\\$[0-9A-Fa-f]*\\$",
      "name": "constant.other.hex-string.providex"
    },
    "mnemonic": {
      "match": "(?<![A-Za-z0-9_$%)\\]])'[^'\"\\s=,;()]{0,12}'",
      "name": "constant.other.mnemonic.providex"
    },
    "member": {
      "patterns": [
        {
          "match": "(?<=[A-Za-z0-9_$%)\\]])'([A-Za-z_][A-Za-z0-9_.]*[$%]?)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.member.providex"
            }
          }
        },
        {
          "match": "(?<=[A-Za-z0-9_$%)\\]])'([A-Za-z_][A-Za-z0-9_.]*[$%]?)",
          "captures": {
            "1": {
              "name": "variable.other.property.providex"
            }
          }
        }
      ]
    },
    "special": {
      "match": "(?i)\\*(NEXT|SAME|RETRY|BREAK|CONTINUE|PROCEED|RETURN|END|ESCAPE|ALL)\\b",
      "name": "constant.language.special-target.providex"
    },
    "option": {
      "match": "(?i)(?<=[,(])\\s*(BSY|BSZ|DIR|DOM|END|ERR|FLG|FMT|FNT|HLP|IND|IOL|ISZ|KEY|KNO|LEN|MNU|MSG|NBF|NUL|OPT|OWN|REC|RNO|RSZ|RTY|SEP|SIZ|TBL|TIM|TIP)\\s*(?==)",
      "captures": {
        "1": {
          "name": "keyword.other.option.providex"
        }
      }
    },
    "def-fn": {
      "match": "(?i)\\b(DEF)\\s+(FN%?[A-Za-z_][A-Za-z0-9_.]*[$%]?)",
      "captures": {
        "1": {
          "name": "storage.type.function.providex"
        },
        "2": {
          "name": "entity.name.function.providex"
        }
      }
    },
    "user-function": {
      "match": "(?i)\\bFN%?[A-Za-z_][A-Za-z0-9_.]*[$%]?(?=\\s*\\()",
      "name": "entity.name.function.user.providex"
    },
    "function": {
      "match": "(?i)\\b(SCALL|ABS|ACS|AND|ARG|ASC|ASN|ATH|ATN|BIN|BSZ|CHG|CHR|CMP|COS|CPL|CRC|CSE|CTL|CVS|DEC|DIM|DIR|DLL|DLX|DSK|DTE|ENV|EPT|ERR|EVN|EVS|EXP|FFN|FIB|FID|FIN|FPT|GAP|GBL|GEP|HSA|HSH|HTA|HWN|I3E|I86|IND|INT|IOL|IOR|JST|JUL|KEC|KEF|KEL|KEN|KEP|KEY|KGN|LCS|LEN|LNO|LOG|LRC|LST|MAX|MEM|MID|MIN|MNM|MOD|MSG|MSK|MXC|MXL|NEW|NOT|NUL|NUM|OBJ|OPT|PAD|PCK|PFX|PGM|POS|PRC|PRM|PTH|PUB|RCD|RDX|REC|REF|RND|RNO|SEP|SGN|SIN|SQR|SRT|SSZ|STK|STP|STR|SUB|SWP|SYS|TAN|TBL|TCB|TMR|TRX|TSK|TXH|TXW|UCP|UCS|UPK|VAL|VIN|VIS|XEQ|XFA|XOR)(?=\\s*\\()",
      "name": "support.function.builtin.providex"
    },
    "control": {
      "match": "(?i)\\b(CONTINUE|DEFAULT|END_TRY|EXECUTE|FINALLY|PERFORM|PROCESS|END_IF|ESCAPE|EXITTO|REPEAT|RETURN|SETERR|SETESC|SWITCH|BREAK|CATCH|ENTER|GOSUB|RETRY|UNTIL|WHILE|CALL|CASE|ELSE|EXIT|GOTO|NEXT|QUIT|STEP|STOP|THEN|WAIT|WEND|BYE|END|FOR|RUN|TRY|FI|IF|ON|TO)(?![A-Za-z0-9_$%.])",
      "name": "keyword.control.providex"
    },
    "oop": {
      "match": "(?i)\\b(FUNCTION|PROPERTY|REQUIRED|PROGRAM|CREATE|ENDDEF|OBJECT|STATIC|CLASS|LOCAL|DROP|LIKE|DEF|GET|SET)(?![A-Za-z0-9_$%.])",
      "name": "storage.type.providex"
    },
    "operator-word": {
      "match": "(?i)\\b(AND|NOT|OR)(?![A-Za-z0-9_$%.])",
      "name": "keyword.operator.logical.providex"
    },
    "directive": {
      "match": "(?i)\\b(ERROR_HANDLER|FLOATINGPOINT|SECURITY_MASK|VIDEO_PALETTE|GET_FILE_BOX|RADIO_BUTTON|TRISTATE_BOX|WINPRT_SETUP|H_SCROLLBAR|LINE_SWITCH|MESSAGE_LIB|MULTI_MEDIA|SYSTEM_HELP|SYSTEM_JRNL|V_SCROLLBAR|VARDROP_BOX|VARLIST_BOX|CLIP_BOARD|CUSTOM_VBX|DAY_FORMAT|DICTIONARY|MULTI_LINE|POPUP_MENU|PROPERTIES|SHORT_FORM|AUTO_LOCK|CHECK_BOX|DIRECTORY|LONG_FORM|PRECISION|RANDOMIZE|SET_FOCUS|SET_PARAM|TRANSLATE|DROP_BOX|ENDTRACE|LIST_BOX|MENU_BAR|MNEMONIC|PASSWORD|PREINPUT|READDATA|RENUMBER|SETDRIVE|SETMOUSE|SETTRACE|USER_LEX|CONTROL|DISABLE|EXTRACT|INDEXED|PROCEED|RELEASE|RESTORE|SET_NBF|SETTIME|ACCEPT|BUTTON|DEFCTL|DEFPRT|DEFTTY|DELETE|DIRECT|ENABLE|EXCEPT|INSERT|INVOKE|IOLIST|MSGBOX|OBTAIN|PREFIX|RANDOM|RECORD|REFILE|REMOVE|RENAME|SELECT|SERIAL|SERVER|SETCTL|SETDAY|SETDEV|SETFID|UNIQUE|UNLOCK|UPDATE|WINDOW|BEGIN|CHART|CLEAR|CLOSE|CWDIR|ERASE|EVENT|INDEX|INPUT|KEYED|MERGE|PRINT|PURGE|REDIM|RESET|ROUND|START|TABLE|WHERE|WRITE|ADDR|AUTO|DATA|DUMP|EDIT|FILE|FIND|FROM|GRID|HIDE|LIST|LOAD|LOCK|OPEN|READ|SAME|SAVE|SHOW|SORT|SWAP|WITH|ADD|DIM|KEY|LET|OFF|POP|REM|VIA)(?![A-Za-z0-9_$%.])",
      "name": "keyword.other.directive.providex"
    },
    "sysvar": {
      "match": "(?i)\\b(_PARENT|_OBJ|BKG|CHN|CTL|DAY|DLM|DSZ|EOM|ERR|ERS|ESC|GFN|GID|HFN|HLP|HWD|LFA|LFO|LIP|LPG|LWD|MDE|MSE|MSL|NAR|NID|OBJ|PFX|PGN|PRC|PRM|PSZ|QUO|RET|RND|SEP|SID|SSN|SYS|TIM|TME|TMS|TSM|UID|UNT|WHO|FN)(?![A-Za-z0-9_$%.])(?!\\s*\\()",
      "name": "variable.language.system.providex"
    },
    "branch-target": {
      "match": "(?i)(?<=\\b(?:GOTO|GOSUB|EXITTO|SETERR|SETESC)\\s)\\s*([A-Za-z_][A-Za-z0-9_.]*)(?![$%])",
      "captures": {
        "1": {
          "name": "entity.name.label.reference.providex"
        }
      }
    },
    "number": {
      "match": "(?<![A-Za-z_$%])(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?",
      "name": "constant.numeric.providex"
    },
    "global-variable": {
      "match": "%[A-Za-z_][A-Za-z0-9_.]*[$%]?",
      "name": "variable.other.global.providex"
    },
    "string-variable": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_.]*\\$",
      "name": "variable.other.string.providex"
    },
    "variable": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_.]*%?",
      "name": "variable.other.providex"
    },
    "operator": {
      "match": "\\*\\*|<=|>=|<>|=<|=>|><|\\+=|-=|\\*=|/=|\\^=|\\+\\+|--|[-+*/^=<>|&@?]",
      "name": "keyword.operator.providex"
    },
    "punctuation": {
      "patterns": [
        {
          "match": ";",
          "name": "punctuation.terminator.statement.providex"
        },
        {
          "match": ",",
          "name": "punctuation.separator.providex"
        },
        {
          "match": "[{}]",
          "name": "punctuation.section.block.providex"
        },
        {
          "match": "[()\\[\\]]",
          "name": "punctuation.section.brackets.providex"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.providex"
        }
      ]
    }
  }
}